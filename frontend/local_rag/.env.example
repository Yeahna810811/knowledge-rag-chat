# Local embedding model (downloaded from Hugging Face on first use)
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# Alibaba Cloud Bailian / DashScope (OpenAI-compatible API)
DASHSCOPE_API_KEY=your_dashscope_api_key_here
CHAT_MODEL=qwen-plus
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Text splitting and retrieval
CHUNK_SIZE=500
CHUNK_OVERLAP=50
RETRIEVAL_TOP_K=4

# 检索策略：bm25（默认）/ dense / hybrid
# 选型依据见 evaluation/EVALUATION_AUDIT.md：在本项目语料上 BM25 显著优于
# 稠密路与等权混合检索，且不需要加载 embedding 模型。
RETRIEVAL_MODE=bm25

# 纯 BM25 且索引已落盘时，跳过 embedding 模型加载（冷启动 0ms）。
# 只有同时需要 dense / hybrid、或索引缺失需要回填时才置 false。
RETRIEVAL_LAZY_DENSE=true

# BM25 零命中时是否回落到稠密路（兜底召回）。
RETRIEVAL_DENSE_FALLBACK=true

# 仅 retrieval_mode=hybrid 时生效：RRF 融合的两路权重。
HYBRID_BM25_WEIGHT=1.0
HYBRID_DENSE_WEIGHT=1.0

# BM25 稀疏索引落盘目录（服务重启后从这里恢复，无需重跑 embedding）。
BM25_INDEX_DIR=data/bm25_index

# ---------------------------------------------------------------------------
# 数据库（会话持久化：Conversation + Message）
# ---------------------------------------------------------------------------
# 本机 Python 进程直连 Docker 暴露出来的 MySQL：
DATABASE_URL=mysql+pymysql://rag_user:rag_password@127.0.0.1:3306/knowledge_rag?charset=utf8mb4
#
# Docker Compose 内部网络（host 必须写服务名 mysql，不要写 localhost）：
# DATABASE_URL=mysql+pymysql://rag_user:rag_password@mysql:3306/knowledge_rag?charset=utf8mb4
#
# 不配置时回落到 SQLite 文件（frontend/local_rag/data/rag_app.db），
# 方便本地调试与 CI 跑测试，无需启动 MySQL。
# Windows 路径示例：sqlite:///C:/path/to/rag_app.db
DATABASE_ECHO=false

# Docker Compose 里 mysql 服务的初始化参数（与 docker-compose.yml 保持一致）
MYSQL_DATABASE=knowledge_rag
MYSQL_USER=rag_user
MYSQL_PASSWORD=rag_password
MYSQL_ROOT_PASSWORD=change_me_root_password

# ---------------------------------------------------------------------------
# Redis（检索缓存 + 限流）
# ---------------------------------------------------------------------------
# Redis 不是数据源：会话历史在 MySQL，知识库在本地索引文件。
# Redis 挂掉只会导致「缓存不命中 + 限流放开」，问答仍然可用。
#
# 本机 Python 进程直连本地 Redis：
REDIS_URL=redis://127.0.0.1:6379/0
#
# Docker Compose 内部网络（host 必须写服务名 redis，不要写 localhost）：
# REDIS_URL=redis://redis:6379/0
#
# 需要密码时直接写在 URL 里，不要另设一个明文变量：
# REDIS_URL=redis://:your_password@redis:6379/0

# 检索结果缓存。关闭后每次 RAG 都真的检索一遍（排障 / 压测对照用）。
REDIS_CACHE_ENABLED=true
# 缓存 TTL（秒）。知识库内容变化时会靠版本号失效，不靠这个 TTL 保证正确性。
REDIS_CACHE_TTL_SECONDS=600

# /api/ask 限流（按 session_id 计数，固定窗口）
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# LangSmith observability (optional)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=knowledge-rag-chat
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# CI / automation webhook (optional). Send header: X-Webhook-Secret
WEBHOOK_SECRET=

# Optional server settings
HOST=0.0.0.0
PORT=8000
